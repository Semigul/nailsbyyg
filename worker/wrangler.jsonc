{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nailsbyyg-order-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "nailsbyg-955c8",
    "ALLOWED_ORIGINS": "https://semigul.github.io,http://localhost:5500,http://127.0.0.1:5500",
    "VAPID_SUBJECT": "https://semigul.github.io/nailsbyyg/"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_NOTIFICATION_HUB",
        "class_name": "OrderNotificationHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderNotificationHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
