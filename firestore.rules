rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAnonymousCustomer() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function isValidCustomerOrder(orderId) {
      return isAnonymousCustomer()
        && request.resource.data.keys().hasOnly([
          "customer",
          "contact",
          "product",
          "quantity",
          "deliveryMethod",
          "address",
          "dueDate",
          "notes",
          "price",
          "weight",
          "shippingCost",
          "status",
          "designImagePaths",
          "approvedDesignImageUrls",
          "moderationStatus",
          "moderationReason",
          "moderationUpdatedAt",
          "source",
          "orderType",
          "marketplaceItemId",
          "marketplaceImageUrl",
          "paymentStatus",
          "swishReference",
          "customerId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.customer is string
        && request.resource.data.customer.size() > 0
        && request.resource.data.customer.size() <= 40
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 100
        && request.resource.data.product is string
        && request.resource.data.product.size() > 0
        && request.resource.data.product.size() <= 80
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 99
        && request.resource.data.deliveryMethod in ["Postas", "Hämtas"]
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 250
        && (
          request.resource.data.deliveryMethod == "Hämtas"
          || request.resource.data.address.size() > 0
        )
        && request.resource.data.dueDate is string
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.designImagePaths is list
        && request.resource.data.designImagePaths.size() <= 4
        && request.resource.data.approvedDesignImageUrls is list
        && request.resource.data.approvedDesignImageUrls.size() <= 4
        && (
          (
            request.resource.data.designImagePaths.size() == 0
            && request.resource.data.moderationStatus == "approved"
          )
          || (
            request.resource.data.designImagePaths.size() > 0
            && request.resource.data.approvedDesignImageUrls.size() == 0
            && request.resource.data.moderationStatus == "pending"
          )
        )
        && request.resource.data.moderationReason is string
        && request.resource.data.moderationReason.size() <= 160
        && request.resource.data.moderationUpdatedAt is int
        && request.resource.data.weight == 0
        && request.resource.data.status == "Ny"
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && (
          (
            request.resource.data.source == "customer"
            && request.resource.data.orderType == "custom"
            && request.resource.data.price == 0
            && request.resource.data.shippingCost == 0
            && request.resource.data.marketplaceItemId == ""
            && request.resource.data.marketplaceImageUrl == ""
            && request.resource.data.paymentStatus == "Ej aktuell"
            && request.resource.data.swishReference == ""
          )
          || (
            request.resource.data.source == "marketplace"
            && request.resource.data.orderType == "marketplace"
            && request.resource.data.quantity == 1
            && request.resource.data.designImagePaths.size() == 0
            && request.resource.data.approvedDesignImageUrls.size() == 0
            && request.resource.data.paymentStatus == "Väntar på Swish"
            && request.resource.data.swishReference == ""
            && request.resource.data.marketplaceItemId.size() > 0
            && getAfter(
              /databases/$(database)/documents/marketplaceItems/$(request.resource.data.marketplaceItemId)
            ).data.status == "reserved"
            && getAfter(
              /databases/$(database)/documents/marketplaceItems/$(request.resource.data.marketplaceItemId)
            ).data.reservedBy == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/marketplaceItems/$(request.resource.data.marketplaceItemId)
            ).data.reservedOrderId == orderId
            && request.resource.data.product == getAfter(
              /databases/$(database)/documents/marketplaceItems/$(request.resource.data.marketplaceItemId)
            ).data.title
            && request.resource.data.price == getAfter(
              /databases/$(database)/documents/marketplaceItems/$(request.resource.data.marketplaceItemId)
            ).data.price
            && request.resource.data.marketplaceImageUrl == getAfter(
              /databases/$(database)/documents/marketplaceItems/$(request.resource.data.marketplaceItemId)
            ).data.imageUrl
            && (
              (
                request.resource.data.deliveryMethod == "Hämtas"
                && request.resource.data.shippingCost == 0
              )
              || (
                request.resource.data.deliveryMethod == "Postas"
                && request.resource.data.shippingCost == getAfter(
                  /databases/$(database)/documents/marketplaceItems/$(request.resource.data.marketplaceItemId)
                ).data.shippingCost
              )
            )
          )
        );
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if isAdmin() || isValidCustomerOrder(orderId);
      allow read, update, delete: if isAdmin();
    }

    match /orderShares/{shareToken} {
      allow get: if isAdmin()
        || (
          shareToken.size() == 48
          && resource.data.active == true
          && resource.data.expiresAt is int
          && resource.data.expiresAt > request.time.toMillis()
        );
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /publicSettings/{settingId} {
      allow get: if settingId == "marketplace";
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /marketplaceItems/{itemId} {
      allow read: if isAdmin()
        || (
          resource.data.status == "available"
          && get(
            /databases/$(database)/documents/publicSettings/marketplace
          ).data.visible == true
        );
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isAnonymousCustomer()
          && get(
            /databases/$(database)/documents/publicSettings/marketplace
          ).data.visible == true
          && resource.data.status == "available"
          && request.resource.data.status == "reserved"
          && request.resource.data.reservedBy == request.auth.uid
          && request.resource.data.reservedOrderId is string
          && request.resource.data.reservedOrderId.size() > 0
          && request.resource.data.updatedAt is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "reservedBy",
            "reservedOrderId",
            "updatedAt"
          ])
          && getAfter(
            /databases/$(database)/documents/orders/$(request.resource.data.reservedOrderId)
          ).data.marketplaceItemId == itemId
          && getAfter(
            /databases/$(database)/documents/orders/$(request.resource.data.reservedOrderId)
          ).data.customerId == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
